# Supabase: Project Settings > Database > Connection string (URI). Neon: dashboard > Connection string.
DATABASE_URL=postgresql://user:password@host:5432/dbname
SESSION_SECRET=change-me-to-a-long-random-string
BASE_URL=http://localhost:3000

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web)
# Authorized redirect URI: BASE_URL + /auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mailgun > Sending > Domains (use EU url https://api.eu.mailgun.net if your domain is in the EU)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.yourdomain.com
MAILGUN_URL=https://api.mailgun.net
MAIL_FROM=Your Shop <orders@mg.yourdomain.com>
