{
  "name": "shop",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "db:init": "node -e \"require('dotenv').config();const {Pool}=require('pg');new Pool({connectionString:process.env.DATABASE_URL,ssl:{rejectUnauthorized:false}}).query(require('fs').readFileSync('schema.sql','utf8')).then(()=>{console.log('DB ready');process.exit()}).catch(e=>{console.error(e);process.exit(1)})\""
  },
  "dependencies": {
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "form-data": "^4.0.0",
    "mailgun.js": "^10.2.3",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.12.0",
    "serverless-http": "^4.0.0"
  }
}
